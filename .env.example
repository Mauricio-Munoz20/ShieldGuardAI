# ==============================================================================
# ShieldGuard AI - Configuración de Variables de Entorno (Plantilla)
# ==============================================================================
# Copia este archivo como .env para ajustar parámetros en entornos locales o contenedores.
# NOTA: Ninguna de estas variables es obligatoria; todas cuentan con valores por defecto.

# ------------------------------------------------------------------------------
# Backend Go (Orquestador y API)
# ------------------------------------------------------------------------------
# Dirección y puerto de escucha del servidor Go (default :8080)
SHIELDGUARD_ADDR=:8080

# Ruta del archivo de persistencia de estado atómico (default data/shieldguard-state.json)
SHIELDGUARD_DATA=data/shieldguard-state.json

# URL del servicio de Machine Learning en sombra (dejar vacío si no se usa ML)
SHIELDGUARD_ML_URL=http://127.0.0.1:8090

# ------------------------------------------------------------------------------
# Microservicio ML Python (CatBoost Shadow Scorer)
# ------------------------------------------------------------------------------
# Host y puerto para el servidor HTTP de inferencia Python
SHIELDGUARD_ML_ADDR=127.0.0.1
SHIELDGUARD_ML_PORT=8090

# Rutas locales a los artefactos entrenados
SHIELDGUARD_MODEL=artifacts/catboost.cbm
SHIELDGUARD_MODEL_METADATA=artifacts/metadata.json

